# StockInvoice configuration. Copy to `.env` and adjust.
# Never commit a real .env (it is git-ignored).

# --- server ---
PORT=8080
DEFAULT_LOCALE=en          # en | fr | ar

# --- security ---
# MUST be random, 32+ characters. If unset/short an ephemeral key is generated
# at boot (sessions stop working after a restart).
SECRET_KEY=change-me-to-a-random-32-plus-char-session-key
JWT_SECRET_KEY=change-me-to-a-random-32-plus-char-jwt-signing-key
JWT_ACCESS_TOKEN_EXPIRES=3600   # seconds
COOKIE_SECURE=0                 # set to 1 when serving over HTTPS

# --- database ---
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=stockinvoice

# --- messaging ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f
# Optional: full management API URL (derived from RABBITMQ_URL by default).
# RABBITMQ_MGMT_URL=http://localhost:15672

# --- first-run seed (only used when the database is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=looklook
COMPANY_NAME="StockInvoice"   # quoted: dotenvy rejects unquoted spaces
