/target
.env
.env.local
*.log
/.checks
static/fonts/*
!static/fonts/.gitkeep
!static/fonts/README.md
!static/fonts/arabic.ttf
!static/fonts/OFL.txt
!static/fonts/Comfortaa-Light.ttf
!static/fonts/Comfortaa-Regular.ttf
!static/fonts/Comfortaa-Bold.ttf
!static/fonts/OFL-Comfortaa.txt

# cache of the downloaded SVGs behind /tools/fetch_papicons.py
.paplicons_tmp/

# Android client build output and machine-local paths
/android/.gradle
/android/build
/android/app/build
/android/local.properties
/android/.idea
*.apk
!android/dist/*.apk

# The phone app's fonts: Comfortaa is OFL, but VIP Rawy is a licensed face and
# stays out of the repository, exactly like static/fonts/VIP-Rawy-*.ttf.
/android/app/src/main/assets/fonts/*.ttf
!/android/app/src/main/assets/fonts/Comfortaa-*.ttf

# Runtime database settings written by the Settings page
app-settings.json
